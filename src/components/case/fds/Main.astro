---
/**
 * Hero + at a glance. Follows the Recruitment SaaS Main pattern:
 * headline, large visual, project meta strip, then a four-card stat bento.
 * Set `heroImage` to the component-sheet file name once it is in
 * public/media/figma-design-system/; until then a placeholder frame shows.
 */
import { m } from '../../../data/fds-media';

const heroImage: string | null = 'hero-library.webp';
const heroSize = [1600, 900];

const meta = [
  { k: 'Company', v: 'SPH Media' },
  { k: 'Project timeline', v: '3 months' },
  { k: 'My role', v: 'UX Designer' },
  { k: 'Tools used', v: 'Figma · Adobe Illustrator · Notion' },
];
---
<div style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">

  <section aria-label="Introduction" class="fds-hero">
    <div class="fds-hero__grid" aria-hidden="true"><div class="fds-hero__cols">{Array.from({ length: 12 }, () => <span />)}</div></div>

    <div class="fds-hero__in" style="padding-top: clamp(64px, 8vw, 112px); padding-bottom: clamp(40px, 5vw, 64px); display: flex; flex-direction: column; align-items: flex-start;">
      <p class="rise" style="margin: 0 0 20px; display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: 14px; font-weight: 600; letter-spacing: 0.01em; color: #A9BEDF;">
        <span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 2px; background: #EF4123;"></span>
        Figma Design System · ST Digital News
      </p>
      <h1 class="rise rise-2 fds-h1" style="margin: 0; font-family: var(--font-display); font-weight: 500; line-height: 1.1; letter-spacing: -0.03em; color: #FFFFFF;">One shared design language for a fast&#8209;moving newsroom</h1>
      <p class="rise rise-3" style="margin: 22px 0 0; max-width: none; text-wrap: pretty; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.65; color: rgba(255,255,255,0.82);">A tokenised Figma library for The Straits Times digital team: from colour and type tokens to full page templates, in light and dark, so every news product starts from the same foundation.</p>
    </div>

    <div class="fds-hero__in rise rise-4">
      {heroImage ? (
        <img src={m(heroImage)} width={heroSize[0]} height={heroSize[1]} alt="The library’s three tiers side by side: colour, type and spacing tokens; buttons, chips, search, audio player, tabs and cards in light and dark; and a mobile news homepage template in both modes" style="display: block; width: 100%; height: auto; border-radius: 16px; border: 1px solid rgba(255,255,255,0.28); box-shadow: 0 30px 80px rgba(2,8,20,0.45); background: #FFFFFF;" />
      ) : (
        <div class="fds-ph" role="img" aria-label="Component sheet image to come" style={`aspect-ratio: ${heroSize[0]} / ${heroSize[1]};`}>
          <span>Component sheet · image to come</span>
        </div>
      )}
    </div>

    <div class="fds-hero__in" style="padding-top: clamp(32px, 4vw, 48px); padding-bottom: clamp(48px, 6vw, 80px);">
      <dl class="hstrip" aria-label="Project details" style="margin: 0;">
        {meta.map((d) => (
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.22);">
            <dt style="font-family: var(--font-display); font-size: 16px; font-weight: 600; color: #FFFFFF;">{d.k}</dt>
            <dd style="margin: 0; font-size: 15px; line-height: 1.45; color: rgba(255,255,255,0.82);">{d.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section aria-label="At a glance" style="box-sizing: border-box; width: 100%; background: var(--surface-page);">
    <div class="bento" style="box-sizing: border-box; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(56px, 8vw, 104px) var(--gutter);">
      <div class="tile" style="background: #FFFFFF; border: 1px solid #EBE8E4;">
        <div class="tile__n" style="color: var(--accent);">90%</div>
        <div class="tile__l" style="color: #68615A;">Efficiency gained by building from templates</div>
      </div>
      <div class="tile" style="background: #E3EAF6; border: 1px solid #D2DCEE;">
        <div class="tile__n" style="color: var(--accent);">75%</div>
        <div class="tile__l" style="color: #4F4740;">Time saved on file management and upkeep</div>
      </div>
      <div class="tile" style="background: #FFFFFF; border: 1px solid #EBE8E4;">
        <div class="tile__n" style="color: var(--accent);">30%</div>
        <div class="tile__l" style="color: #68615A;">More accurate design-to-dev handoff</div>
      </div>
      <div class="tile" style="background: var(--accent);">
        <div class="tile__n" style="color: #FFFFFF;">3 tiers</div>
        <div class="tile__l" style="color: rgba(255,255,255,0.86);">Tokens, components, templates</div>
      </div>
    </div>
  </section>

</div>

<style>
/* Headline holds one line from tablet up; wraps naturally on phones */
.fds-h1{font-size:clamp(34px,3.85vw,56px)}
@media (min-width: 960px){.fds-h1{white-space:nowrap}}
@media (prefers-reduced-motion: no-preference){
.rise{opacity:0;transform:translateY(14px);animation:rise .8s cubic-bezier(.16,1,.3,1) forwards}
.rise-2{animation-delay:.08s}.rise-3{animation-delay:.16s}.rise-4{animation-delay:.26s}
@keyframes rise{to{opacity:1;transform:none}}
}
.fds-hero{position:relative;isolation:isolate;overflow:hidden;width:100%;display:flex;flex-direction:column;color:#FFFFFF;background:radial-gradient(120% 80% at 85% 0%, #17396F 0%, rgba(23,57,111,0) 60%), var(--accent)}
.fds-hero__in{position:relative;box-sizing:border-box;width:100%;max-width:calc(var(--content-max) + 2 * var(--gutter));margin:0 auto;padding-left:var(--gutter);padding-right:var(--gutter)}
/* Layout-grid motif: the 12-column desktop grid (4 on mobile) inside the content width, fading toward the bottom */
.fds-hero__grid{position:absolute;inset:0;z-index:-1;pointer-events:none;-webkit-mask-image:linear-gradient(180deg,#000 0%,rgba(0,0,0,.7) 40%,transparent 80%);mask-image:linear-gradient(180deg,#000 0%,rgba(0,0,0,.7) 40%,transparent 80%)}
.fds-hero__cols{box-sizing:border-box;height:100%;max-width:calc(var(--content-max) + 2 * var(--gutter));margin:0 auto;padding:0 var(--gutter);display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:24px}
.fds-hero__cols span{background:rgba(255,255,255,0.035);border-left:1px solid rgba(255,255,255,0.05);border-right:1px solid rgba(255,255,255,0.05)}
@media (max-width: 640px){.fds-hero__cols{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.fds-hero__cols span:nth-child(n+5){display:none}}
.fds-ph{box-sizing:border-box;width:100%;display:flex;align-items:center;justify-content:center;border-radius:16px;border:1px dashed rgba(255,255,255,0.4);background:rgba(255,255,255,0.06);font-family:var(--font-display);font-size:14px;font-weight:500;color:rgba(255,255,255,0.7)}
.hstrip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px}
@media (max-width: 900px){.hstrip{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 480px){.hstrip{grid-template-columns:minmax(0,1fr);gap:18px}}
.bento{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
@media (max-width: 900px){.bento{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 420px){.bento{gap:12px}}
.tile{box-sizing:border-box;min-height:clamp(160px,14vw,200px);padding:clamp(20px,2.2vw,28px);border-radius:var(--radius-card);display:flex;flex-direction:column;justify-content:space-between;gap:32px}
.tile__n{font-family:var(--font-display);font-weight:500;font-size:clamp(36px,3.6vw,52px);line-height:1;letter-spacing:-0.03em}
.tile__l{font-size:clamp(14px,1.1vw,16px);line-height:1.45;max-width:240px}
</style>
