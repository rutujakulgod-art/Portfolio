---
/**
 * LV 1 components, LV 2 templates and the layout grid.
 * Screenshot slots: set img on comps[] / templates[] (files in public/media/figma-design-system/)
 * and the dashed placeholders are replaced by the images.
 */
import { m } from '../../../data/fds-media';

type Shot = { label: string; img: string | null; w?: number; h?: number; alt?: string };

const atoms = ['Buttons', 'Inputs', 'Chips', 'Toggles'];
const comps = ['Players', 'Menus', 'Cards'];

const variants: Shot[] = [
  { label: 'Light', img: null },
  { label: 'Dark', img: null },
];

const templates: Shot[] = [
  { label: 'Homepage', img: null },
  { label: 'Article', img: null },
  { label: 'Section page', img: null },
];
---
<section aria-labelledby="fds-library" style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">
  <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(56px, 8vw, 104px) var(--gutter); display: flex; flex-direction: column; gap: clamp(48px, 6vw, 80px);">

    <div style="display: flex; flex-direction: column; gap: 18px;">
      <span style="font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--accent-2);">Components and templates</span>
      <h2 id="fds-library" class="l-h2" style="margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.12; letter-spacing: -0.03em; color: #251F19;">From single atoms to finished pages</h2>
      <p style="margin: 0; max-width: 860px; font-size: 17px; line-height: 1.65; color: #68615A;">Tokens feed the components, components build the templates, and one layout grid keeps every page lined up, on mobile and desktop alike.</p>
    </div>

    <!-- LV 1 -->
    <div class="blk">
      <div class="hd">
        <span class="lv">LV 1</span>
        <h3>Components and UI atoms</h3>
        <p>Small atoms combine into the larger components a news product is made of. Every one is built on tokens, so each has a light and a dark variant from the start.</p>
      </div>

      <div class="kinds">
        <div class="panel">
          <h4 class="ph">UI atoms</h4>
          <ul class="tags">{atoms.map((a) => <li>{a}</li>)}</ul>
        </div>
        <div class="panel panel--navy">
          <h4 class="ph">Components</h4>
          <ul class="tags">{comps.map((a) => <li>{a}</li>)}</ul>
        </div>
      </div>

      <ul class="var" aria-label="Light and dark variants">
        {variants.map((v, i) => (
          <li class={i === 1 ? 'var--dark' : ''}>
            <span class="var__lb"><span class="var__dot" aria-hidden="true"></span>{v.label}</span>
            {v.img ? (
              <img src={m(v.img)} width={v.w} height={v.h} alt={v.alt ?? `Components in ${v.label.toLowerCase()} mode`} loading="lazy" />
            ) : (
              <div class="slot" role="img" aria-label={`${v.label} components screenshot to come`}>{v.label} components screenshot to come</div>
            )}
          </li>
        ))}
      </ul>
    </div>

    <!-- LV 2 -->
    <div class="blk">
      <div class="hd">
        <span class="lv">LV 2</span>
        <h3>Mockups and templates</h3>
        <p>Page templates assembled from components and following ST’s UX patterns. The team starts every new product from one of these instead of a blank file.</p>
      </div>
      <ul class="tpl" aria-label="Templates">
        {templates.map((t) => (
          <li>
            {t.img ? (
              <img src={m(t.img)} width={t.w} height={t.h} alt={t.alt ?? `${t.label} template`} loading="lazy" />
            ) : (
              <div class="slot slot--tall" role="img" aria-label={`${t.label} template screenshot to come`}>Template screenshot to come</div>
            )}
            <span class="tpl__n">{t.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Layout grid -->
    <div class="blk">
      <div class="hd">
        <span class="lv">Layout grid</span>
        <h3>One grid, two breakpoints</h3>
        <p>Fixed frame widths and margins give designers and developers the same measurements to build to.</p>
      </div>

      <div class="grid panel">
        <figure class="fr fr--d">
          <div class="fr__box" style="--mg: 32; --fw: 1440;" aria-hidden="true">
            <span class="fr__bar"></span>
            <div class="fr__in">
              <span class="b b--hero"></span>
              <span class="b"></span><span class="b"></span><span class="b"></span>
            </div>
            <span class="fr__mg fr__mg--l">32</span><span class="fr__mg fr__mg--r">32</span>
          </div>
          <figcaption><b>Desktop</b><span>1440 px frame · 32 px margins</span></figcaption>
        </figure>

        <figure class="fr fr--m">
          <div class="fr__box" style="--mg: 16; --fw: 375;" aria-hidden="true">
            <span class="fr__bar"></span>
            <div class="fr__in">
              <span class="b b--hero"></span>
              <span class="b b--w"></span><span class="b b--w"></span>
            </div>
            <span class="fr__mg fr__mg--l">16</span><span class="fr__mg fr__mg--r">16</span>
          </div>
          <figcaption><b>Mobile</b><span>375 px frame · 16 px margins</span></figcaption>
        </figure>
      </div>
    </div>

  </div>
</section>

<style>
@media (min-width: 960px){.l-h2{white-space:nowrap}}
.blk{display:flex;flex-direction:column;gap:16px}
.hd{display:flex;flex-direction:column;gap:6px;margin-bottom:8px}
.lv{font-family:var(--font-display);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--accent-2)}
.hd h3{margin:0;font-family:var(--font-display);font-size:clamp(24px,2.2vw,30px);font-weight:500;letter-spacing:-0.02em;color:#251F19}
.hd p{margin:0;max-width:720px;font-size:16px;line-height:1.6;color:#68615A}
.panel{box-sizing:border-box;padding:clamp(22px,2.6vw,32px);border-radius:var(--radius-card);background:#FFFFFF;border:1px solid #EBE8E4;min-width:0}
.panel--navy{background:var(--accent);border-color:var(--accent)}
.ph{margin:0 0 16px;font-family:var(--font-display);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#68615A}
.panel--navy .ph{color:rgba(255,255,255,.72)}

.kinds{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
@media (max-width: 760px){.kinds{grid-template-columns:minmax(0,1fr)}}
.tags{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:10px}
.tags li{display:inline-flex;align-items:center;height:38px;padding:0 16px;border-radius:999px;background:#F3F5F9;border:1px solid #E3E7EE;font-family:var(--font-display);font-size:15px;font-weight:500;color:var(--accent)}
.panel--navy .tags li{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.2);color:#FFFFFF}

/* Screenshot slots */
.slot{box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:100%;aspect-ratio:16/10;border-radius:10px;border:1px dashed #C9D1DE;background:#F6F8FB;font-size:13px;font-weight:500;color:#7A8597;text-align:center;padding:16px}
.slot--tall{aspect-ratio:3/4}

.var{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
@media (max-width: 760px){.var{grid-template-columns:minmax(0,1fr)}}
.var li{box-sizing:border-box;padding:clamp(18px,2.2vw,26px);border-radius:var(--radius-card);background:#FFFFFF;border:1px solid #EBE8E4;display:flex;flex-direction:column;gap:14px;min-width:0}
.var li.var--dark{background:#30353E;border-color:#30353E}
.var__lb{display:inline-flex;align-items:center;gap:8px;font-family:var(--font-display);font-size:13px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#68615A}
.var__dot{width:10px;height:10px;border-radius:50%;background:#FFFFFF;box-shadow:inset 0 0 0 1px rgba(0,0,0,.2)}
.var--dark .var__lb{color:rgba(255,255,255,.75)}
.var--dark .var__dot{background:#30353E;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.7)}
.var--dark .slot{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.25);color:rgba(255,255,255,.6)}
.var img,.tpl img{display:block;width:100%;height:auto;border-radius:10px}

.tpl{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media (max-width: 900px){.tpl{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 560px){.tpl{grid-template-columns:minmax(0,1fr)}}
.tpl li{box-sizing:border-box;padding:clamp(14px,1.6vw,18px);border-radius:var(--radius-card);background:#FFFFFF;border:1px solid #EBE8E4;display:flex;flex-direction:column;gap:12px;min-width:0}
.tpl__n{font-family:var(--font-display);font-size:16px;font-weight:600;color:#251F19;padding:0 4px 4px}

/* Layout grid frames */
.grid{display:grid;grid-template-columns:minmax(0,3.2fr) minmax(0,1fr);gap:clamp(24px,4vw,56px);align-items:end;background:#F3F5F9;border-color:#E3E7EE}
@media (max-width: 760px){.grid{grid-template-columns:minmax(0,1fr)}.fr--m{max-width:220px}}
.fr{margin:0;display:flex;flex-direction:column;gap:14px;min-width:0}
.fr__box{position:relative;box-sizing:border-box;border-radius:10px;background:#FFFFFF;border:1px solid #D2DCEE;overflow:hidden;box-shadow:0 10px 30px rgba(12,40,87,.08);
  /* margin shown to scale, with a floor so it stays visible */
  --pad:max(10px, calc(var(--mg) / var(--fw) * 100%))}
.fr--d .fr__box{aspect-ratio:1440/860}
.fr--m .fr__box{aspect-ratio:375/760}
.fr__bar{position:absolute;top:0;left:0;right:0;display:block;height:9%;background:var(--accent)}
.fr__in{position:absolute;top:9%;bottom:0;left:0;right:0;margin:0 var(--pad);padding:7% 0;box-sizing:border-box;display:grid;gap:6%;align-content:start;
}
.fr--d .fr__in{grid-template-columns:repeat(3,minmax(0,1fr));gap:5% 3%}
.fr--m .fr__in{grid-template-columns:minmax(0,1fr);gap:4%}
.b{display:block;border-radius:6px;background:#E3EAF6;aspect-ratio:4/3}
.b--hero{grid-column:1/-1;aspect-ratio:auto;height:clamp(60px,11vw,150px);background:#D2DCEE}
.fr--m .b--hero{height:auto;aspect-ratio:4/3}
.b--w{aspect-ratio:3/1}
.fr__mg{position:absolute;top:9%;bottom:0;width:var(--pad);box-sizing:border-box;background:rgba(239,65,35,.12);display:flex;align-items:center;justify-content:center;writing-mode:vertical-rl;font-family:var(--font-display);font-size:11px;font-weight:700;letter-spacing:.04em;color:#B3260F}
.fr__mg--l{left:0;border-right:1px dashed rgba(239,65,35,.55)}
.fr__mg--r{right:0;border-left:1px dashed rgba(239,65,35,.55)}
.fr figcaption{display:flex;flex-direction:column;gap:2px}
.fr figcaption b{font-family:var(--font-display);font-size:16px;font-weight:600;color:#251F19}
.fr figcaption span{font-size:14px;color:#68615A}
</style>
