---
import { m } from '../../../data/recruitment-media';
---
<div style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">

  <section aria-label="Introduction" class="herobg" style={`--hero-img: url(${m('dd50ea8876b033d0e9d6cae97f5959c9')}); box-sizing: border-box; width: 100%; display: flex; flex-direction: column; color: #FFFFFF;`}>

    <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(64px, 8vw, 112px) var(--gutter) clamp(40px, 5vw, 64px); display: flex; flex-direction: column; align-items: flex-start; text-align: left;">
      <h1 class="rise" style="margin: 0; max-width: 1120px; font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 4.6vw, 62px); line-height: 1.1; letter-spacing: -0.03em; color: #FFFFFF;">From scattered spreadsheets to one hiring platform for five roles</h1>
      <p class="rise rise-2" style="margin: 22px 0 0; max-width: 640px; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.65; color: rgba(255,255,255,0.82);">Replacing spreadsheets, email threads and vendor portals with one role-aware recruitment platform for five distinct users.</p>
    </div>

    <div class="rise rise-3" style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: 0 var(--gutter);">
      <video src={m('610825fac59bdd2e3af020cf47af8f66')} poster={m('8aa7d1551c81fa98d5ddfd776a8efcb6')} autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline" aria-label="Product walkthrough: switching roles, units and sub units, users, filters and assigning" style="display: block; width: 100%; height: auto; aspect-ratio: 1600 / 812; border-radius: 16px; border: 1px solid rgba(255,255,255,0.35); box-shadow: 0 30px 80px rgba(2,10,22,0.45); background: #FFFFFF;"></video>
    </div>

    <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(32px, 4vw, 48px) var(--gutter) clamp(48px, 6vw, 80px);">
      <dl class="hstrip" aria-label="Project details" style="margin: 0;">
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.22);">
            <dt style="font-family: var(--font-display); font-size: 16px; font-weight: 600; color: #FFFFFF;">Role</dt>
            <dd style="margin: 0; font-size: 15px; font-weight: 400; line-height: 1.45; color: rgba(255,255,255,0.82);">Product Designer</dd>
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.22);">
            <dt style="font-family: var(--font-display); font-size: 16px; font-weight: 600; color: #FFFFFF;">Platform</dt>
            <dd style="margin: 0; font-size: 15px; font-weight: 400; line-height: 1.45; color: rgba(255,255,255,0.82);">Web SaaS</dd>
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.22);">
            <dt style="font-family: var(--font-display); font-size: 16px; font-weight: 600; color: #FFFFFF;">Scope</dt>
            <dd style="margin: 0; font-size: 15px; font-weight: 400; line-height: 1.45; color: rgba(255,255,255,0.82);">Hiring Setup &amp; Candidate Sourcing</dd>
          </div>
      </dl>
    </div>
  </section>

  <section aria-label="At a glance" style="box-sizing: border-box; width: 100%; background: var(--surface-page);">
    <div class="bento" style="box-sizing: border-box; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(56px, 8vw, 104px) var(--gutter);">
      <div style="box-sizing: border-box; min-height: clamp(160px, 14vw, 200px); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: #FFFFFF; border: 1px solid #EBE8E4;">
        <div style="font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 3.6vw, 52px); line-height: 1; letter-spacing: -0.03em; color: var(--accent);">5</div>
        <div style="font-size: clamp(14px, 1.1vw, 16px); line-height: 1.45; max-width: 240px; color: #68615A;">Distinct roles, one platform</div>
      </div>
      <div style="box-sizing: border-box; min-height: clamp(160px, 14vw, 200px); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: #E3EEFA; border: 1px solid #D3E3F6;">
        <div style="font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 3.6vw, 52px); line-height: 1; letter-spacing: -0.03em; color: var(--accent);">80%</div>
        <div style="font-size: clamp(14px, 1.1vw, 16px); line-height: 1.45; max-width: 240px; color: #4F4740;">Expected reduction in duplication errors</div>
      </div>
      <div style="box-sizing: border-box; min-height: clamp(160px, 14vw, 200px); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: #FFFFFF; border: 1px solid #EBE8E4;">
        <div style="font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 3.6vw, 52px); line-height: 1; letter-spacing: -0.03em; color: var(--accent);">3</div>
        <div style="font-size: clamp(14px, 1.1vw, 16px); line-height: 1.45; max-width: 240px; color: #68615A;">Key flows designed end to end</div>
      </div>
      <div style="box-sizing: border-box; min-height: clamp(160px, 14vw, 200px); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: var(--accent);">
        <div style="font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 3.6vw, 52px); line-height: 1; letter-spacing: -0.03em; color: #FFFFFF;">Multi</div>
        <div style="font-size: clamp(14px, 1.1vw, 16px); line-height: 1.45; max-width: 240px; color: rgba(255,255,255,0.86);">Tenant, scalable architecture</div>
      </div>
    </div>
  </section>

</div>

<style>
@media (prefers-reduced-motion: no-preference){
.rise{opacity:0;transform:translateY(14px);animation:rise .8s cubic-bezier(.16,1,.3,1) forwards}
.rise-2{animation-delay:.08s}.rise-3{animation-delay:.16s}.rise-4{animation-delay:.26s}
@keyframes rise{to{opacity:1;transform:none}}
}
.bento{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
@media (max-width: 900px){.bento{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 420px){.bento{gap:12px}}
.herobg{background:linear-gradient(180deg, rgba(6,18,36,0.62) 0%, rgba(6,18,36,0.38) 45%, rgba(6,18,36,0.72) 100%), var(--hero-img) center / cover no-repeat, #1C2A3C}
.hstrip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
@media (max-width: 640px){.hstrip{grid-template-columns:minmax(0,1fr);gap:18px}}
</style>
