    <div style="box-sizing: border-box; padding: clamp(28px, 4vw, 48px); border-radius: var(--radius-card); background: var(--accent); color: #FFFFFF; display: flex; flex-direction: column; gap: 12px;">
      <h3 style="margin: 0; font-family: var(--font-display); font-size: 20px; font-weight: 700; letter-spacing: -0.01em; color: #FFFFFF;">Design challenge</h3>
