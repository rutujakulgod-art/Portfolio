---
import { m } from '../../../data/ecommerce-media';
---
<div style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">

  <section aria-label="Introduction" class="herobg" style={`--hero-img: url(${m('hero-store.webp')}); box-sizing: border-box; width: 100%; display: flex; flex-direction: column; color: #FFFFFF;`}>

    <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(64px, 8vw, 112px) var(--gutter) clamp(40px, 5vw, 64px); display: flex; flex-direction: column; align-items: flex-start; text-align: left;">
      <h1 class="rise" style="margin: 0; max-width: 1120px; font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 4.6vw, 62px); line-height: 1.1; letter-spacing: -0.03em; color: #FFFFFF;">Helping musicians find the right instrument online</h1>
      <p class="rise rise-2" style="margin: 22px 0 0; max-width: 640px; font-size: clamp(17px, 1.4vw, 19px); line-height: 1.65; color: rgba(255,255,255,0.82);">Redesigning City Music’s store so shoppers can filter, compare and hear instruments before they buy, with less guesswork and fewer wasted trips.</p>
    </div>

    <div class="rise rise-3" style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: 0 var(--gutter);">
      <div class="hmedia">
        <img src={m('hero-listing-laptop.webp')} width="1242" height="758" alt="Redesigned City Music guitar listing page on a laptop, with stock, brand and shape filters, sorting, and price, rating and add to cart on every card" style="display: block; width: 100%; height: auto; filter: drop-shadow(0 30px 60px rgba(20,4,4,0.5));">
      </div>
    </div>

    <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(32px, 4vw, 48px) var(--gutter) clamp(48px, 6vw, 80px);">
      <dl class="hstrip" aria-label="Project details" style="margin: 0;">
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.22);">
            <dt style="font-family: var(--font-display); font-size: 16px; font-weight: 600; color: #FFFFFF;">Role</dt>
            <dd style="margin: 0; font-size: 15px; font-weight: 400; line-height: 1.45; color: rgba(255,255,255,0.82);">UX Designer, team of 3</dd>
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.22);">
            <dt style="font-family: var(--font-display); font-size: 16px; font-weight: 600; color: #FFFFFF;">Timeline</dt>
            <dd style="margin: 0; font-size: 15px; font-weight: 400; line-height: 1.45; color: rgba(255,255,255,0.82);">2 weeks</dd>
          </div>
          <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.22);">
            <dt style="font-family: var(--font-display); font-size: 16px; font-weight: 600; color: #FFFFFF;">Platform</dt>
            <dd style="margin: 0; font-size: 15px; font-weight: 400; line-height: 1.45; color: rgba(255,255,255,0.82);">E-commerce website</dd>
          </div>
      </dl>
    </div>
  </section>

  <section aria-label="At a glance" style="box-sizing: border-box; width: 100%; background: var(--surface-page);">
    <div class="bento" style="box-sizing: border-box; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(56px, 8vw, 104px) var(--gutter);">
      <div style="box-sizing: border-box; min-height: clamp(160px, 14vw, 200px); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: #FFFFFF; border: 1px solid #EBE8E4;">
        <div style="font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 3.6vw, 52px); line-height: 1; letter-spacing: -0.03em; color: var(--accent);">7</div>
        <div style="font-size: clamp(14px, 1.1vw, 16px); line-height: 1.45; max-width: 240px; color: #68615A;">Musicians interviewed, aged 31 to 56</div>
      </div>
      <div style="box-sizing: border-box; min-height: clamp(160px, 14vw, 200px); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: #FBECEC; border: 1px solid #F3D7D7;">
        <div style="font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 3.6vw, 52px); line-height: 1; letter-spacing: -0.03em; color: var(--accent);">100%</div>
        <div style="font-size: clamp(14px, 1.1vw, 16px); line-height: 1.45; max-width: 240px; color: #4F4740;">Of testers found the new filters and sorting useful</div>
      </div>
      <div style="box-sizing: border-box; min-height: clamp(160px, 14vw, 200px); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: #FFFFFF; border: 1px solid #EBE8E4;">
        <div style="font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 3.6vw, 52px); line-height: 1; letter-spacing: -0.03em; color: var(--accent);">80%</div>
        <div style="font-size: clamp(14px, 1.1vw, 16px); line-height: 1.45; max-width: 240px; color: #68615A;">Used the new compare feature and found it useful</div>
      </div>
      <div style="box-sizing: border-box; min-height: clamp(160px, 14vw, 200px); padding: clamp(20px, 2.2vw, 28px); border-radius: var(--radius-card); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; background: var(--accent);">
        <div style="font-family: var(--font-display); font-weight: 500; font-size: clamp(36px, 3.6vw, 52px); line-height: 1; letter-spacing: -0.03em; color: #FFFFFF;">75%</div>
        <div style="font-size: clamp(14px, 1.1vw, 16px); line-height: 1.45; max-width: 240px; color: rgba(255,255,255,0.9);">Keen to video call a store expert from the product page</div>
      </div>
    </div>
  </section>

</div>

<style>
@media (prefers-reduced-motion: no-preference){
.rise{opacity:0;transform:translateY(14px);animation:rise .8s cubic-bezier(.16,1,.3,1) forwards}
.rise-2{animation-delay:.08s}.rise-3{animation-delay:.16s}.rise-4{animation-delay:.26s}
@keyframes rise{to{opacity:1;transform:none}}
}
.bento{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
@media (max-width: 900px){.bento{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 420px){.bento{gap:12px}}
.herobg{background:linear-gradient(180deg, rgba(34,10,10,0.80) 0%, rgba(34,10,10,0.68) 45%, rgba(34,10,10,0.88) 100%), var(--hero-img) center / cover no-repeat, #2A1414}
.hmedia{max-width:1040px;margin:0 auto}
.hstrip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}
@media (max-width: 640px){.hstrip{grid-template-columns:minmax(0,1fr);gap:18px}}
</style>
