---
import SectionHead from './SectionHead.astro';
import Steps from './Steps.astro';
import Screen from './Screen.astro';
import StageFlow from './StageFlow.astro';
import { m } from '../../../data/los-media';

const hotspots = [
  { n: 1, x: 16.5, y: 56, t: 'Master navigation', d: 'All 49 masters in one searchable side list.' },
  { n: 2, x: 19.5, y: 13.6, t: 'Search', d: 'Jump straight to a master by name.' },
  { n: 3, x: 72, y: 16.4, t: 'One toolbar', d: 'Sort, filter, import, export, and New, in the same place on every master.' },
  { n: 4, x: 52, y: 25.5, t: 'Shared table', d: 'Same column pattern, row actions on the right.' },
  { n: 5, x: 90, y: 82, t: 'Pagination', d: 'Consistent paging and result count.' },
];
const minis = [
  { src: 'masters-templates-list', w: 1908, h: 894, cap: 'Templates: same layout, different master', alt: 'Templates master showing email, SMS and letter templates in the same table layout' },
  { src: 'masters-roles-add-state', w: 1914, h: 900, cap: 'Add mode: insert a role at a specific rank', alt: 'Roles & Entitlements in add mode: each row shows a plus button, with the hint Click the + to add a role below' },
  { src: 'masters-edit-role', w: 1908, h: 904, cap: 'Edit a value: grouped form, permissions on the same page', alt: 'Edit Role form with role details and a Set Permissions panel' },
];

const leadSteps = [
  { src: 'leads-list', w: 1280, h: 810, alt: 'Leads list with name, contact, email, loan product, assignee and a Hot, Warm or Cold priority tag; the row menu offers Edit Info, Convert and Delete', title: 'Find or triage a lead', text: 'Priority tags and row actions: edit, convert, delete.' },
  { src: 'lead-add-form', w: 1280, h: 856, alt: 'Add New Lead form split into Lead Details and Customer Details panels, with mandatory fields marked', title: 'Capture a new lead', text: 'Lead details and customer details, mandatory fields marked.' },
  { src: 'lead-existing-customer-lookup', w: 1902, h: 910, alt: 'Existing User Lookup dialog over the Add New Lead form, with a single customer search field', title: 'Reuse an existing customer', text: 'Look up a previous customer instead of retyping.' },
];
const userSteps = [
  { src: 'users-dashboard', w: 1906, h: 906, alt: 'Dashboard with financial year, quarter and branch filters, a donut chart of users by staff, customer and guest, and a target status chart by branch', title: 'See the picture', text: 'Dashboard filtered by financial year, quarter, and branch.' },
  { src: 'users-employees-list', w: 1912, h: 900, alt: 'Employees list with sort, filters, CSV import, export and New Employee actions; personal details are blurred', title: 'Manage users', text: 'Sort, filters, import, and export in one toolbar.' },
  { src: 'users-permissions-matrix', w: 1906, h: 866, alt: 'Review Permissions for the Super Admin role: a grid of features such as Users, Masters and Leads against actions such as create, read, update, delete, reassign and transfer', title: 'Set what each role can do', text: 'Permissions reviewed as a feature-by-action grid before saving a role.' },
];

const masterGroups = [
  { label: 'Institution & Product', items: ['Institute / Bank', 'Branches', 'Loan Types', 'Loan Products', 'Channels'] },
  { label: 'Financial Parameters', items: ['Credit Parameters', 'Risk Parameters', 'Assets / Incomes / Liabilities', 'Credit Rating Mapping'] },
  { label: 'Documents & Collateral', items: ['Documents', 'Document Map', 'Collateral Types', 'Templates', '+ 30 more'] },
];

---
<section aria-label="Ideate" style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">
  <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(56px, 8vw, 104px) var(--gutter); display: flex; flex-direction: column; gap: clamp(32px, 4vw, 48px);">

    <SectionHead eyebrow="03 · Ideate" title="Three modules, three depths">I went deeper into requirements and edge cases for Leads, User Management, and Masters. For Loan Application, I focused on understanding and mapping the flow rather than owning the design.</SectionHead>

    <!-- Lead Creation -->
    <article class="mod" id="los-leads" aria-label="Lead Creation">
      <header class="mod__head">
        <span class="mod__tag">Focus area 1</span>
        <h3 class="mod__title">Lead Creation</h3>
        <p class="mod__lead">The Leads module captures potential customers interested in taking a loan.</p>
      </header>
      <div class="pair">
        <div class="pcard"><h4>SRS requirements</h4><p>Add new lead, tabular list with search, sort, and pagination, view and edit, create from a previous customer, fetch via UCIC (CBS), director and PAN checks, takeover loans with confidential uploads, bulk upload, in-principle sanction tags.</p></div>
        <div class="pcard pcard--mine"><h4>What I worked on</h4><p>Lead capture flow with clear mandatory fields; a filterable list view with status indicators; a bulk upload flow (template, validation, errors); and edge cases like CBS integration and takeover loans.</p></div>
      </div>
      <Steps steps={leadSteps} label="Lead Creation screens" />
    </article>

    <!-- User Management -->
    <article class="mod" id="los-users" aria-label="User Management">
      <header class="mod__head">
        <span class="mod__tag">Focus area 2</span>
        <h3 class="mod__title">User Management</h3>
        <p class="mod__lead">Handles internal users, their roles, and permissions.</p>
      </header>
      <div class="pair">
        <div class="pcard"><h4>SRS requirements</h4><p>Create users with designation, role, branch, and limits; transfer with approval workflow; terminate with soft delete; update, reset, and activate; dashboard with filters and export; bulk upload; self-registration; CBS sync; MFA and session policies; role-based authorization.</p></div>
        <div class="pcard pcard--mine"><h4>What I worked on</h4><p>Creation and update flows with logical grouping; a user dashboard (filters, sort, export); a bulk upload flow; role and permission concepts; and security states: MFA, session timeout, password reset, account lock.</p></div>
      </div>
      <Steps steps={userSteps} label="User Management screens" />
    </article>

    <!-- Masters -->
    <article class="mod" id="los-masters" aria-label="Masters">
      <header class="mod__head">
        <span class="mod__tag">Focus area 3</span>
        <h3 class="mod__title">Masters</h3>
        <p class="mod__lead">The SRS defines 49 different master types. Each shapes how the rest of the loan process behaves.</p>
      </header>
      <div class="groups">
        {masterGroups.map((g) => (
          <div class="group">
            <span class="group__label">{g.label}</span>
            <ul class="pills">
              {g.items.map((t) => <li class:list={[t.startsWith('+') && 'pill--more']}>{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="mod__lead">Focused on a consistent list pattern across all masters, clear add/edit forms, visible permissions, and dependency awareness (e.g. product → document map → application fields).</p>
      <div class="anat">
        <figure class="anat__img">
          <img src={m('masters-roles-list')} width="1918" height="906" loading="lazy" decoding="async" alt="Roles & Entitlements master: a searchable list of all masters on the left and a table of roles with sort, filter, import, export and New on the right">
          {hotspots.map((h) => <span class="hs" style={`left:${h.x}%;top:${h.y}%`} aria-hidden="true">{h.n}</span>)}
        </figure>
        <ol class="anat__legend" aria-label="Parts of the shared master template">
          {hotspots.map((h) => <li><span aria-hidden="true">{h.n}</span><div><h4>{h.t}</h4><p>{h.d}</p></div></li>)}
        </ol>
      </div>
      <ul class="mini" aria-label="The same template on other masters">
        {minis.map((x) => (
          <li><figure><img src={m(x.src)} width={x.w} height={x.h} alt={x.alt} loading="lazy" decoding="async"><figcaption>{x.cap}</figcaption></figure></li>
        ))}
      </ul>
    </article>

    <!-- Loan Application -->
    <article class="mod" id="los-application" aria-label="Loan Application">
      <header class="mod__head">
        <span class="mod__tag">Focus area 4 · Involvement</span>
        <h3 class="mod__title">Loan Application</h3>
        <p class="mod__lead">My involvement, not ownership. The core of the LOS: a 17-stage journey from application entry to post-disbursement documents.</p>
      </header>
      <aside class="disclose" aria-label="Scope disclosure">
          <span class="disclose__tag">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8h0M11 12h1v5h1"/></svg>
            Scope disclosure
          </span>
          <p>I didn’t own this design. I mapped the flow from the SRS, noted which fields were mandatory, conditional, or auto-populated, and joined discussions on structuring steps. That analysis shaped my work on Leads, Users, and Masters.</p>
        </aside>
      <StageFlow />
      <div class="la-screen">
        <Screen src="application-personal-details" w={1280} h={1200} alt="Application #36, Personal Details step: a stage rail on the left lists every step from Application Details to Post Disbursement Documents, with grouped form sections on the right and Save draft beside Save & next" caption="The journey in the product: a stage rail on every application step, with Save draft." />
      </div>
    </article>


  </div>
</section>

<style>
.mod{display:flex;flex-direction:column;gap:clamp(20px,2.6vw,28px);padding-top:clamp(40px,5vw,64px);border-top:1px solid #EBE8E4}
.mod__head{display:flex;flex-direction:column;gap:10px}
.mod__tag{align-self:flex-start;font-family:var(--font-display);font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:var(--accent);background:#EAF4F4;border:1px solid #D3E7E8;padding:5px 12px;border-radius:999px}
.mod__title{margin:0;font-family:var(--font-display);font-weight:500;font-size:clamp(26px,2.6vw,34px);line-height:1.15;letter-spacing:-0.02em;color:#251F19}
.mod__lead{margin:0;max-width:860px;font-size:16px;line-height:1.65;color:#68615A}
.pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.duo{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,2vw,24px);align-items:start}
@media (max-width: 900px){.pair,.duo{grid-template-columns:minmax(0,1fr)}}
.pcard{box-sizing:border-box;padding:clamp(20px,2.4vw,28px);border-radius:var(--radius-card);background:#FFFFFF;border:1px solid #EBE8E4;display:flex;flex-direction:column;gap:8px}
.pcard h4{margin:0;font-family:var(--font-display);font-size:17px;font-weight:600;color:#251F19}
.pcard p{margin:0;font-size:15px;line-height:1.6;color:#4F4740}
.pcard--mine{background:#EAF4F4;border-color:#D3E7E8;border-left:4px solid var(--accent)}
.pcard--mine h4{color:#002329}
.groups{display:flex;flex-direction:column;gap:14px}
.group{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px;align-items:start}
@media (max-width: 760px){.group{grid-template-columns:minmax(0,1fr);gap:8px}}
.group__label{padding-top:7px;font-family:var(--font-display);font-size:13px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;color:#4C6367}
.pills{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.pills li{padding:7px 14px;border-radius:999px;background:#FFFFFF;border:1px solid #D3E7E8;font-size:14px;color:#002329}
.pills .pill--more{background:var(--accent);border-color:var(--accent);color:#FFFFFF}
@media (max-width: 900px){
    }
.anat{display:grid;grid-template-columns:minmax(0,2.3fr) minmax(0,1fr);gap:clamp(20px,3vw,40px);align-items:center;padding:clamp(20px,3vw,40px);border-radius:var(--radius-card);background:linear-gradient(160deg,#EAF4F4 0%,#D3E7E8 100%);border:1px solid #D3E7E8}
.anat__img{position:relative;margin:0}
.anat__img img{display:block;width:100%;height:auto;border-radius:10px;border:1px solid #D3E7E8;box-shadow:0 24px 50px -22px rgba(0,35,41,.45);background:#FFFFFF}
.hs{position:absolute;transform:translate(-50%,-50%);width:30px;height:30px;border-radius:999px;background:var(--accent);color:#FFFFFF;font-family:var(--font-display);font-weight:600;font-size:14px;display:flex;align-items:center;justify-content:center;box-shadow:0 0 0 5px rgba(0,109,117,.22)}
.anat__legend{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px}
.anat__legend li{display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px}
.anat__legend span{width:28px;height:28px;border-radius:999px;background:var(--accent);color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:600;font-size:13px}
.anat__legend h4{margin:3px 0 0;font-family:var(--font-display);font-size:16px;font-weight:600;color:#002329}
.anat__legend p{margin:3px 0 0;font-size:14px;line-height:1.5;color:#4F4740}
.mini{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(12px,1.6vw,20px)}
.mini figure{margin:0;display:flex;flex-direction:column;gap:10px}
.mini img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;object-position:left top;border-radius:10px;border:1px solid #D3E7E8;box-shadow:0 14px 30px -18px rgba(0,35,41,.3);background:#FFFFFF}
.mini figcaption{font-size:14px;line-height:1.5;color:#68615A}
@media (max-width: 900px){
  .anat{grid-template-columns:minmax(0,1fr)}
  .hs{width:22px;height:22px;font-size:12px;box-shadow:0 0 0 3px rgba(0,109,117,.22)}
  .mini{grid-template-columns:minmax(0,1fr)}
}
.la-screen :global(img){aspect-ratio:1280/760;object-fit:cover;object-position:left top}
.disclose{max-width:860px;box-sizing:border-box;padding:clamp(20px,2.4vw,28px);border-radius:var(--radius-card);background:#FFFFFF;border:1.5px dashed #C2BAB1;display:flex;flex-direction:column;gap:12px}
.disclose__tag{align-self:flex-start;display:inline-flex;align-items:center;gap:6px;font-family:var(--font-display);font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;color:#68615A;background:#EEEDE6;padding:5px 12px;border-radius:999px}
.disclose p{margin:0;font-size:16px;line-height:1.65;color:#3B342D}
</style>
