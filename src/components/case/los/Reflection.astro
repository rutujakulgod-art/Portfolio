---
import SectionHead from './SectionHead.astro';

const next = [
  'Run usability sessions with real loan officers, underwriters, and admins: a research phase this project didn’t yet include.',
  'Test how well the status and progress indicators work under real workload.',
  'Explore how to further simplify long forms without losing required data.',
  'Improve the reports section with better filters and visualizations for decision makers.',
];
---
<section aria-label="Final reflection" style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">
  <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: 0 var(--gutter) clamp(56px, 8vw, 104px); display: flex; flex-direction: column; gap: clamp(32px, 4vw, 48px);">

    <SectionHead eyebrow="Final reflection" title="If I continued this project" />

    <ol class="next">
      {next.map((t, i) => (
        <li><span class="next__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span>{t}</span></li>
      ))}
    </ol>
  </div>

  <div class="close">
    <figure class="close__inner">
      <span class="close__eyebrow">In summary</span>
      <blockquote>
        <p>This case study shows how I handled a complex, unfamiliar domain, collaborated with stakeholders, and used UX to make a regulated workflow more understandable, with deeper contributions in Leads, Users, and Masters.</p>
      </blockquote>
    </figure>
  </div>
</section>

<style>
.next{list-style:none;margin:0;padding:0;max-width:960px;display:flex;flex-direction:column}
.next li{display:grid;grid-template-columns:40px minmax(0,1fr);column-gap:12px;padding:18px 0;border-top:1px solid #EBE8E4;font-size:17px;line-height:1.6;color:#3B342D}
.next li:last-child{border-bottom:1px solid #EBE8E4}
.next__no{font-family:var(--font-display);font-size:14px;font-weight:600;color:var(--accent);padding-top:3px}
.close{box-sizing:border-box;width:100%;background:radial-gradient(120% 90% at 90% 0%,rgba(0,109,117,.6) 0%,rgba(0,109,117,0) 60%),#002329}
.close__inner{box-sizing:border-box;max-width:calc(var(--content-max) + 2 * var(--gutter));margin:0 auto;padding:clamp(72px,10vw,140px) var(--gutter);display:flex;flex-direction:column;gap:28px}
.close__eyebrow{font-family:var(--font-display);font-size:15px;font-weight:600;color:#8FD3D6}
.close blockquote{margin:0;padding:0}
.close blockquote p{margin:0;max-width:1080px;font-family:var(--font-display);font-weight:500;font-size:clamp(28px,3.6vw,50px);line-height:1.18;letter-spacing:-0.03em;color:#FFFFFF}
</style>
