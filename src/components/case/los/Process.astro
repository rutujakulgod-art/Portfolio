---
const phases = [
  { no: '01', name: 'Discover', items: ['Reading the SRS end to end', 'Building a domain glossary', 'Clarifying ambiguities with the team'] },
  { no: '02', name: 'Define', items: ['Mapping the loan journey', 'Identifying roles and needs per stage', 'Naming friction points'] },
  { no: '03', name: 'Ideate', items: ['Information architecture for Leads, Users, and Masters', 'Flow sketches', 'Translating SRS requirements into patterns'] },
  { no: '04', name: 'Design', items: ['Style guide', 'Hi-fi screens in Figma', 'Design decisions documented for handoff'] },
];
---
<section aria-label="Process" style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">
  <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(56px, 8vw, 104px) var(--gutter); display: flex; flex-direction: column; gap: clamp(32px, 4vw, 48px);">

    <div style="display: flex; flex-direction: column; gap: 18px;">
      <span style="font-family: var(--font-display); font-size: 14px; font-weight: 600; color: var(--brand);">Process</span>
      <h2 style="margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(32px, 3.4vw, 48px); line-height: 1.12; letter-spacing: -0.03em; color: #251F19;">How the work actually unfolded</h2>
      <p style="margin: 0; max-width: 860px; font-size: 17px; line-height: 1.65; color: #68615A;">Four phases, not five. There was no formal research or usability-testing phase on this project yet, so rather than pad it out, the phase rail below stops where the real work stopped. That gap is named honestly in the Reflection section.</p>
    </div>

    <ol class="rail" aria-label="Project phases">
      {phases.map((p) => (
        <li class="rail__row">
          <span class="rail__no">{p.no}</span>
          <h3 class="rail__name">{p.name}</h3>
          <ul class="rail__items">
            {p.items.map((t) => <li>{t}</li>)}
          </ul>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
.rail{list-style:none;margin:0;padding:0;border-radius:var(--radius-card);background:#002329;overflow:hidden}
.rail__row{display:grid;grid-template-columns:72px minmax(0,1fr) minmax(0,2fr);gap:20px;align-items:center;padding:clamp(20px,2.4vw,28px) clamp(20px,3vw,36px);border-top:1px solid rgba(255,255,255,.08)}
.rail__row:first-child{border-top:0}
.rail__no{font-family:var(--font-display);font-size:14px;font-weight:600;color:#8FD3D6}
.rail__name{margin:0;font-family:var(--font-display);font-size:clamp(20px,1.8vw,24px);font-weight:500;letter-spacing:-0.01em;color:#FFFFFF}
.rail__items{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.rail__items li{padding:6px 12px;border-radius:999px;background:rgba(143,211,214,.1);border:1px solid rgba(143,211,214,.22);font-size:14px;line-height:1.4;color:#CDEBEC}
@media (max-width: 760px){
  .rail__row{grid-template-columns:44px minmax(0,1fr);row-gap:12px;align-items:start}
  .rail__items{grid-column:2}
}
</style>
