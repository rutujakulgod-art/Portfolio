---
import SectionHead from './SectionHead.astro';

const items = [
  { t: 'Replacing a system is about pain points, too', d: 'As much about understanding what was broken as designing what’s new.' },
  { t: 'Complex workflows need clarity', d: 'Structure and labels matter more than fancy visuals.' },
  { t: 'Status and progress are critical', d: 'Users need to know where they are and what is next.' },
  { t: 'Configuration UX is still UX', d: 'Masters may be “back office,” but they define how the whole system behaves.' },
  { t: 'Lead creation is the first impression', d: 'A clean, fast lead flow sets the tone for the entire journey.' },
  { t: 'It’s okay to be new', d: 'I learned fast by reading docs, asking questions, and mapping things out visually.' },
];
---
<section aria-label="What I learned" style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">
  <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(56px, 8vw, 104px) var(--gutter); display: flex; flex-direction: column; gap: clamp(32px, 4vw, 48px);">

    <SectionHead eyebrow="What I learned" title="Reflections from the work" />

    <ol class="learn">
      {items.map((x, i) => (
        <li class="learn__item">
          <span class="learn__no">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="learn__t">{x.t}</h3>
          <p class="learn__d">{x.d}</p>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
.learn{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media (max-width: 1000px){.learn{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 600px){.learn{grid-template-columns:minmax(0,1fr)}}
.learn__item{box-sizing:border-box;padding:clamp(20px,2.4vw,28px);border-radius:var(--radius-card);background:#FFFFFF;border:1px solid #EBE8E4;border-top:3px solid var(--accent);display:flex;flex-direction:column;gap:8px}
.learn__no{font-family:var(--font-display);font-size:13px;font-weight:600;color:var(--accent)}
.learn__t{margin:6px 0 0;font-family:var(--font-display);font-size:19px;font-weight:500;line-height:1.3;color:#251F19}
.learn__d{margin:0;font-size:15px;line-height:1.6;color:#68615A}
</style>
