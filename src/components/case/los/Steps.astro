---
/** Numbered flow strip: screens side by side at one crop, each with a step caption. */
import Screen from './Screen.astro';
interface Step { src: string; w: number; h: number; alt: string; title: string; text: string }
interface Props { steps: Step[]; label: string }
const { steps, label } = Astro.props;
---
<ol class="steps" aria-label={label}>
  {steps.map((s, i) => (
    <li class="steps__item">
      <Screen src={s.src} w={s.w} h={s.h} alt={s.alt} />
      <div class="steps__cap">
        <span class="steps__no" aria-hidden="true">{i + 1}</span>
        <div>
          <h4>{s.title}</h4>
          <p>{s.text}</p>
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,24px)}
.steps__item{display:flex;flex-direction:column;gap:16px;min-width:0}
.steps__item :global(img){aspect-ratio:16/10;object-fit:cover;object-position:left top}
.steps__cap{display:grid;grid-template-columns:32px minmax(0,1fr);gap:12px}
.steps__no{width:32px;height:32px;border-radius:999px;background:var(--accent);color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:600;font-size:14px}
.steps__cap h4{margin:4px 0 0;font-family:var(--font-display);font-size:17px;font-weight:600;color:#251F19}
.steps__cap p{margin:4px 0 0;font-size:14px;line-height:1.55;color:#68615A}
@media (max-width: 900px){.steps{grid-template-columns:minmax(0,1fr);gap:32px}}
</style>
