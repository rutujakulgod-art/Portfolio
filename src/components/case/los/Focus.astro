---
import SectionHead from './SectionHead.astro';

const items = [
  { t: 'Understandable steps', d: 'Organizing the application flow into clear, sequential steps.', i: 'steps' },
  { t: 'Reduced cognitive load', d: 'Grouping fields logically: applicant info, finance, collateral, loan details.', i: 'group' },
  { t: 'Status visibility', d: 'So users always know where a lead or application is and what’s blocking progress.', i: 'status' },
  { t: 'Document handling', d: 'Clear upload states, file type requirements, and error messages.', i: 'doc' },
  { t: 'Tables & dashboards', d: 'Views for internal teams managing many leads, users, and applications.', i: 'table' },
  { t: 'Permissions & roles', d: 'So users only see what they’re allowed to see and do.', i: 'lock' },
  { t: 'Security & auditability', d: 'MFA, session management, and activity logs shaping the experience.', i: 'shield' },
  { t: 'Responsive scope', d: 'Tablet and laptop internally, mobile-first for the customer entry point.', i: 'devices' },
];
---
<section aria-label="Key UX focus areas" style="box-sizing: border-box; width: 100%; background: var(--surface-page); color: #251F19; font-family: var(--font-text); -webkit-font-smoothing: antialiased;">
  <div style="box-sizing: border-box; width: 100%; max-width: calc(var(--content-max) + 2 * var(--gutter)); margin: 0 auto; padding: clamp(56px, 8vw, 104px) var(--gutter); display: flex; flex-direction: column; gap: clamp(32px, 4vw, 48px);">

    <SectionHead eyebrow="Key UX focus areas" title="Beyond Leads, Users, and Masters" />

    <ul class="fa">
      {items.map((x) => (
        <li class="fa__item">
          <span class="fa__icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              {x.i === 'steps' && <><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><path d="M7 12h3M14 12h3"/></>}
              {x.i === 'group' && <><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="8" height="6" rx="1.5"/><rect x="13" y="14" width="8" height="6" rx="1.5"/></>}
              {x.i === 'status' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
              {x.i === 'doc' && <><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 17v-6M9.5 13.5 12 11l2.5 2.5"/></>}
              {x.i === 'table' && <><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M3 14h18M9 9v11"/></>}
              {x.i === 'lock' && <><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></>}
              {x.i === 'shield' && <><path d="M12 3 4.5 6v6c0 4.4 3.2 7.9 7.5 9 4.3-1.1 7.5-4.6 7.5-9V6z"/><path d="m9 12 2 2 4-4"/></>}
              {x.i === 'devices' && <><rect x="2" y="5" width="14" height="10" rx="1.5"/><path d="M6 19h6"/><rect x="17" y="9" width="5" height="10" rx="1.2"/></>}
            </svg>
          </span>
          <h3 class="fa__t">{x.t}</h3>
          <p class="fa__d">{x.d}</p>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
.fa{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
@media (max-width: 1100px){.fa{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width: 560px){.fa{grid-template-columns:minmax(0,1fr)}}
.fa__item{box-sizing:border-box;padding:clamp(20px,2.2vw,26px);border-radius:var(--radius-card);background:#FFFFFF;border:1px solid #EBE8E4;display:flex;flex-direction:column;gap:8px}
.fa__icon{width:44px;height:44px;margin-bottom:10px;border-radius:10px;background:#EAF4F4;color:var(--accent);display:flex;align-items:center;justify-content:center}
.fa__t{margin:0;font-family:var(--font-display);font-size:18px;font-weight:500;color:#251F19}
.fa__d{margin:0;font-size:15px;line-height:1.55;color:#68615A}
</style>
