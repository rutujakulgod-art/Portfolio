---
import Button from '../Button.astro';
import { url } from '../../data/site';
---
<section class="hero" aria-label="Introduction" data-hero>
  <div class="hero__zoom">
    <!-- See-through still: shown until the animation starts, and kept when motion is reduced -->
    <img class="hero__art hero__poster" src={url('media/hero-poster.webp')} alt="" aria-hidden="true" width="1600" height="1000" />
    <!-- The video's white background is removed frame by frame onto this canvas -->
    <canvas class="hero__art hero__canvas" width="1600" height="1000" aria-hidden="true" hidden></canvas>
    <video
      class="hero__art hero__src"
      src={url('media/hero-floor-plans.mp4')}
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    ></video>
  </div>

  <div class="hero__head">
    <h1 class="hero__h1">
      <span class="hero__line" data-line="0">“I design systems</span>{' '}
      <span class="hero__line" data-line="1">the way Architects</span>{' '}
      <span class="hero__line" data-line="2">design buildings”</span>
    </h1>
  </div>

  <div class="hero__foot">
    <p class="hero__sub">structural, not decorative.</p>
    <Button href="#work">View selected work</Button>
  </div>

  <button type="button" class="hero__pause" aria-label="Pause background video" data-hero-toggle>
    <svg class="hero__i-pause" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5.5 3.5v9M10.5 3.5v9" /></svg>
    <svg class="hero__i-play" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M5 3.5v9l7.5-4.5z" /></svg>
  </button>
</section>

<style>
  .hero {
    position: relative;
    height: min(calc(var(--vh) * 100 - var(--header-h)), calc(var(--vw) * 60));
    min-height: 600px;
    background: var(--surface-page);
    color: var(--ink);
    overflow: hidden;

    /*
      Layout of the drawing. It is sized so that even at full zoom (1.3x) it stays
      clear of the headline above and the bottom line and button below.
    */
    --zoom: 1.3;
    --hh: max(600px, min(calc(var(--vh) * 100 - var(--header-h)), calc(var(--vw) * 60)));
    --head: calc(clamp(32px, calc(var(--vh) * 6), 64px) + 47px);        /* headline block */
    --foot-pad: clamp(14px, calc(var(--vh) * 2), 24px);                   /* space under the button */
    --foot: calc(var(--foot-pad) + 44px + clamp(14px, calc(var(--vh) * 1.6), 18px) + 31px); /* line + button */
    --gap: 14px;
    --art: calc((var(--hh) - var(--head) - var(--foot) - 2 * var(--gap)) / var(--zoom)); /* drawing height at rest */
    --mid: calc(var(--head) + var(--gap) + var(--art) * var(--zoom) / 2);  /* drawing centre, also the zoom centre */
  }
  .hero__zoom {
    position: absolute;
    inset: 0;
    transform-origin: 50% var(--mid);
    will-change: transform;
    backface-visibility: hidden;
    transform: translateZ(0);
  }
  .hero__art {
    /* In the video frame the drawing spans 11%-88% of the height (77%). */
    --frame: calc(var(--art) / 0.77);
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--mid) - var(--art) / 2 - var(--frame) * 0.11);
    width: 100%;
    height: var(--frame);
    object-fit: contain;
    object-position: center;
  }

  /* The source video stays in place (so browsers keep it playing) but is never seen */
  .hero__src { opacity: 0; pointer-events: none; }
  .hero__canvas[hidden], .hero__poster[hidden] { display: none; }
  /* Fallback when the canvas can't run: show the video, blended into the page */
  .hero.no-canvas .hero__src { opacity: 1; mix-blend-mode: multiply; }
  .hero__head {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 1;
    padding: clamp(32px, calc(var(--vh) * 6), 64px) var(--gutter) 0;
    display: flex;
    justify-content: center;
    text-align: center;
  }
  .hero__h1 {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(24px, 2.9vw, 42px);
    line-height: 1.12;
    word-spacing: 0.14em;
    color: var(--ink);
  }
  .hero__line { display: inline-block; will-change: opacity, transform; }
  .hero__foot {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    z-index: 1;
    padding: 0 var(--gutter) var(--foot-pad);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, calc(var(--vh) * 1.6), 18px);
    text-align: center;
  }
  .hero__sub {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.1;
    color: var(--ink-soft);
  }
  .hero__pause {
    position: absolute;
    z-index: 2;
    right: clamp(16px, 2.4vw, 32px);
    bottom: clamp(16px, calc(var(--vh) * 3), 32px);
    width: 44px; height: 44px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: rgba(238, 237, 230, 0.9);
    color: var(--ink);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    opacity: .72;
    transition: opacity .2s ease;
  }
  .hero:hover .hero__pause, .hero__pause:focus-visible { opacity: 1; }
    .hero__i-play { display: none; }
  .hero.is-paused .hero__i-pause { display: none; }
  .hero.is-paused .hero__i-play { display: block; }

  @media (min-width: 721px) {
    .hero__h1 { white-space: nowrap; }
  }
  @media (min-width: 721px) and (prefers-reduced-motion: no-preference) {
    .hero__zoom { animation: herozoom 4s linear infinite; }
  }
  @keyframes herozoom {
    0% { transform: translateZ(0) scale(1); }
    47% { transform: translateZ(0) scale(1); animation-timing-function: cubic-bezier(.45, 0, .2, 1); }
    91% { transform: translateZ(0) scale(1.3); }
    100% { transform: translateZ(0) scale(1.3); }
  }

  @media (max-width: 720px) {
    .hero { height: auto; min-height: 0; display: flex; flex-direction: column; }
    .hero__zoom { position: relative; inset: auto; transform: none; order: 2; aspect-ratio: 1 / 1; }
    .hero__art { inset: 0; top: 0; height: 100%; object-fit: cover; }
    .hero__head, .hero__foot { position: static; }
    .hero__head { order: 1; }
    .hero__foot { order: 3; padding-top: 8px; }
  }
</style>

<script>
  // Headline lines appear with each floor plan, then fade before the loop restarts.
  // The zoom (CSS animation) is resynced to the video on every loop.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const video = hero?.querySelector<HTMLVideoElement>('video');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.hero__canvas');
  const poster = hero?.querySelector<HTMLImageElement>('.hero__poster');

  // Draws each video frame with its white background turned transparent.
  // For a pixel c on white: alpha = 1 - min(r, g, b); premultiplied colour = c - (1 - alpha).
  function makeKeyer(cv: HTMLCanvasElement, v: HTMLVideoElement) {
    const gl = cv.getContext('webgl', { premultipliedAlpha: true, alpha: true, antialias: false });
    if (!gl) return null;
    const sh = (type: number, src: string) => {
      const o = gl.createShader(type)!; gl.shaderSource(o, src); gl.compileShader(o);
      return gl.getShaderParameter(o, gl.COMPILE_STATUS) ? o : null;
    };
    const vs = sh(gl.VERTEX_SHADER, 'attribute vec2 p;varying vec2 uv;void main(){uv=vec2((p.x+1.)/2.,(1.-p.y)/2.);gl_Position=vec4(p,0.,1.);}');
    const fs = sh(gl.FRAGMENT_SHADER, 'precision mediump float;varying vec2 uv;uniform sampler2D t;void main(){vec3 c=texture2D(t,uv).rgb;float a=1.-min(c.r,min(c.g,c.b));a=a<.04?0.:a;gl_FragColor=vec4(max(c-vec3(1.-a),0.),a);}');
    if (!vs || !fs) return null;
    const pr = gl.createProgram()!; gl.attachShader(pr, vs); gl.attachShader(pr, fs); gl.linkProgram(pr);
    if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) return null;
    gl.useProgram(pr);
    const b = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, b);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(pr, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const tex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    return () => {
      if (v.readyState < 2) return false;
      if (cv.width !== v.videoWidth && v.videoWidth) { cv.width = v.videoWidth; cv.height = v.videoHeight; }
      gl.viewport(0, 0, cv.width, cv.height);
      try { gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, v); } catch (e) { return false; }
      gl.clearColor(0, 0, 0, 0); gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      return true;
    };
  }
  const zoom = hero?.querySelector<HTMLElement>('.hero__zoom');
  const toggle = hero?.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  const lines = hero ? Array.from(hero.querySelectorAll<HTMLElement>('[data-line]')) : [];

  if (hero && video && zoom && toggle && lines.length === 3) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const windows: [number, number][] = [[0.17, 0.55], [1.0, 1.35], [1.62, 1.95]];
    const ease = (x: number) => 1 - Math.pow(1 - x, 3);
    const ramp = (t: number, a: number, b: number) => (t <= a ? 0 : t >= b ? 1 : ease((t - a) / (b - a)));
    const apply = (el: HTMLElement, p: number) => {
      el.style.opacity = String(p);
      el.style.transform = `translateY(${((1 - p) * 14).toFixed(1)}px)`;
    };
    const setPaused = (paused: boolean) => {
      hero.classList.toggle('is-paused', paused);
      toggle.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
    };

    toggle.addEventListener('click', () => {
      if (video.paused) { video.play(); setPaused(false); } else { video.pause(); setPaused(true); }
    });

    // Paint frames onto the see-through canvas while the video plays.
    const draw = canvas ? makeKeyer(canvas, video) : null;
    if (!draw) hero.classList.add('no-canvas');
    let shown = false;
    const paint = () => {
      if (draw && !video.paused && draw()) {
        if (!shown) { shown = true; canvas!.hidden = false; if (poster) poster.hidden = true; }
      }
      requestAnimationFrame(paint);
    };
    if (draw) requestAnimationFrame(paint);
    else video.addEventListener('playing', () => { if (poster) poster.hidden = true; }, { once: true });

    if (reduce) {
      video.removeAttribute('autoplay');
      video.pause();
      setPaused(true);
    } else {
      let last = 0;
      let wasPaused = true;
      const syncZoom = (t: number) => {
        zoom.style.animation = 'none';
        void zoom.offsetWidth;
        zoom.style.animation = '';
        zoom.style.animationDelay = `${(-t).toFixed(3)}s`;
        zoom.style.animationPlayState = 'running';
      };
      const tick = () => {
        if (video.paused) {
          lines.forEach((l) => apply(l, 1));
          if (!wasPaused) zoom.style.animationPlayState = 'paused';
          wasPaused = true;
        } else {
          const t = video.currentTime;
          if (wasPaused || t + 0.3 < last) syncZoom(t);
          wasPaused = false;
          last = t;
          const out = 1 - ramp(t, 3.5, 3.8);
          lines.forEach((l, i) => apply(l, ramp(t, windows[i][0], windows[i][1]) * out));
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
