---
/**
 * Selected Work: intro column on the left, bento of case-study cards on the right.
 * The first case study is the tall card; the other two stack beside it.
 */
import { caseStudies, url } from '../../data/site';
---
<section class="section wk" id="work" aria-labelledby="work-title">
  <div class="wrap wk__grid">

    <div class="wk__intro">
      <h2 id="work-title" class="eyebrow">Selected Work</h2>
      <p class="wk__lede">Enterprise SaaS, fintech loan origination and design systems, from research to handoff.</p>
    </div>

    <ol class="wk__bento">
      {caseStudies.map((c, i) => (
        <li class:list={['wk__item', i === 0 && 'wk__item--tall']}>
          <a class="wk__card" href={url(`work/${c.slug}/`)}>
            <span class="wk__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="wk__title">{c.title}</h3>
            <p class="wk__desc">{c.short}</p>
            <span class="wk__arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10 10 4M5 4h5v5" /></svg>
            </span>
            <span class="visually-hidden">View case study</span>
            <picture>
              {'imageMobile' in c && <source media="(max-width: 640px)" srcset={url(c.imageMobile)} />}
              <img class="wk__art" src={url(c.image)} width={c.imageSize[0]} height={c.imageSize[1]} alt="" loading="lazy" decoding="async" />
            </picture>
          </a>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .wk__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: stretch;
  }

  /* Intro column */
  .wk__intro {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 24px 0 8px;
    min-width: 0;
  }
  .wk__lede {
    margin: 0;
    max-width: 380px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  /* Bento */
  .wk__bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(clamp(300px, 26vw, 360px), auto));
    gap: 16px;
  }
  .wk__item { min-width: 0; display: flex; }
  .wk__item--tall { grid-row: span 2; }

  .wk__card {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 28px 24px;
    border-radius: var(--radius-card);
    background: #FBFAF7;
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: border-color .25s ease, box-shadow .25s ease;
  }
  .wk__card:hover { border-color: var(--line-strong); box-shadow: 0 10px 30px rgba(37, 31, 25, 0.06); }
  .wk__card:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  .wk__num { font-family: var(--font-display); font-size: 13px; font-weight: 600; color: var(--brand); }
  .wk__title {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 1.8vw, 26px);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .wk__desc { margin: 12px 0 0; max-width: 260px; font-size: 14px; line-height: 1.55; color: var(--ink-muted); }
  .wk__arrow {
    margin-top: 22px;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    transition: background-color .25s ease, color .25s ease, border-color .25s ease, transform .35s var(--ease-out);
  }
  .wk__card:hover .wk__arrow { background: var(--brand-ink); border-color: var(--brand-ink); color: #fff; transform: rotate(45deg); }

  .wk__card picture { display: contents; }

  /* Case-study screen bleeds off the bottom-right corner */
  .wk__art {
    position: absolute;
    z-index: -1;
    left: 34%;
    bottom: -14%;
    width: 92%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px rgba(37, 31, 25, 0.14);
    pointer-events: none;
    transition: transform .6s var(--ease-out);
  }
  .wk__item--tall .wk__art { left: 28px; top: 236px; bottom: auto; width: calc(100% - 28px); height: auto; max-width: none; border-radius: 10px 0 0 10px; border-right: 0; }
  .wk__card:hover .wk__art { transform: translateY(-8px); }

  @media (max-width: 1000px) {
    .wk__grid { grid-template-columns: minmax(0, 1fr); }
    @media (max-width: 640px) {
    .wk__bento { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
    .wk__item--tall { grid-row: auto; }
    /* On phones every card gets the same image frame: equal height, cropped from the top left, bleeding off the right and bottom */
    .wk__card, .wk__item--tall .wk__card { min-height: 0; padding-bottom: 0; }
    .wk__art, .wk__item--tall .wk__art {
      position: relative; z-index: 0; top: auto; left: auto; bottom: auto;
      margin: 28px -28px 0 0; width: calc(100% + 28px); max-width: none;
      height: 240px; object-fit: cover; object-position: left top;
      border-radius: 10px 0 0 0; border-right: 0; border-bottom: 0;
    }
  }
</style>
