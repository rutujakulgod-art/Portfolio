---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, url } from '../data/site';

const caps = [
  { title: 'UX & Product Design', icon: 'M4 20l4-1 10-10-3-3L5 16zM14 7l3 3', items: ['Figma & Figma AI', 'Adobe Creative Suite', 'Framer AI', 'Protopie', 'Canva'] },
  { title: 'Research & Testing', icon: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4', items: ['User & stakeholder interviews', 'Optimal Workshop', 'A/B testing', 'Google Analytics', 'Microsoft Power BI'] },
  { title: 'Project Management', icon: 'M4 5h16v14H4zM4 9h16M9 9v10', items: ['Jira & Notion', 'Miro', 'GitHub / VS Code', 'Microsoft Office', 'Cross-functional pods'] },
  { title: 'Spatial & Emerging', icon: 'M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12 4 7.5', items: ['AutoCAD / Revit / SketchUp', 'Blender', 'Claude AI / ChatGPT', 'Google Stitch', 'Building codes (SG)'] },
];
---
<BaseLayout title="About" active="about" description="Rutuja Kulgod: from site plans to digital products. Product designer, systems thinker and user researcher.">

  <section class="ab-hero-sec" aria-labelledby="about-title">
    <div class="wrap ab-hero">
      <img
        src={url('media/about-layers.webp')}
        width="1400"
        height="1247"
        alt="Three stacked layers: a floor plan at the bottom, zoning in the middle and a website wireframe on top"
        fetchpriority="high"
      />
      <div class="ab-hero__text">
        <p class="eyebrow">About</p>
        <h1 id="about-title" class="ab-h1"><span class="ab-quiet">From site plans —</span> to digital products.</h1>
        <ul aria-label="Roles" class="ab-chips">
          <li>Product Designer</li>
          <li>Systems Thinker</li>
          <li>User Researcher</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="ab-story-sec" aria-labelledby="story-title">
    <div class="wrap ab-story">
      <div class="ab-story__head">
        <p class="eyebrow">My story</p>
        <h2 id="story-title" class="ab-h2">The medium changed. <span class="ab-quiet ab-quiet--inline">The discipline stayed the same.</span></h2>
      </div>
      <div class="ab-story__body">
        <p>I’m Rutuja Kulgod. For nearly a decade I’ve been creating experiences, shaping landscapes and urban infrastructure, and now digital products.</p>
        <p>Before UX, I designed built environments across Singapore and India, collaborating with agencies including NParks, LTA, HDB and PUB at DP Architects and Henning Larsen. Those years taught me to think at a human scale: observe how people move through spaces, align diverse stakeholders, and design systems that work in the real world.</p>
        <p>In 2023 I completed General Assembly Singapore’s UX Design Immersive and moved into product design. It was a natural evolution.</p>
        <p>Today I lead end-to-end UX strategy for enterprise SaaS, core banking, AEC tools and digital media, bringing architectural systems thinking, research rigour and a sharp eye for detail to every product.</p>
      </div>
    </div>
  </section>

  <section class="section ab-caps-sec" aria-labelledby="caps-title">
    <div class="wrap">
      <p class="eyebrow">Capabilities</p>
      <h2 id="caps-title" class="ab-h2 ab-caps__h2">The toolkit behind the work.</h2>
      <div class="ab-caps">
        {caps.map((c) => (
          <article class="ab-cap">
            <span aria-hidden="true" class="ab-cap__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={c.icon} /></svg>
            </span>
            <h3 class="ab-cap__title">{c.title}</h3>
            <ul class="ab-cap__list">
              {c.items.map((it) => <li>{it}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="lets-talk" aria-labelledby="talk-title">
    <div class="wrap">
      <div class="ab-talk__head">
        <p class="eyebrow">Let’s talk</p>
        <h2 id="talk-title" class="ab-talk__h2"><span class="ab-quiet">Have a complex system —</span> that needs structure?</h2>
        <p class="ab-talk__lede">Tell me about the problem, the product or the role. I usually reply within a day.</p>
      </div>
      <div class="ab-talk">
        <a href={`mailto:${site.email}`} class="ab-card">
          <span aria-hidden="true" class="ab-card__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6 8.5-6" /></svg></span>
          <h3 class="ab-card__title">Email me directly</h3>
          <p class="ab-card__body">For projects, roles or collaborations. Goes straight to my inbox.</p>
          <span class="ab-link">{site.email}</span>
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener" class="ab-card">
          <span aria-hidden="true" class="ab-card__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V16M8 7.5v.01M12 16v-3.2a2.2 2.2 0 0 1 4.4 0V16M12 10.5V16" /></svg></span>
          <h3 class="ab-card__title">Connect on LinkedIn</h3>
          <p class="ab-card__body">Career history, recommendations and what I’m working on now.</p>
          <span class="ab-link">{site.linkedinLabel}</span>
        </a>
        <a href={url(site.resume)} download={site.resume} class="ab-card">
          <span aria-hidden="true" class="ab-card__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M12 11v6M9.5 14.5 12 17l2.5-2.5" /></svg></span>
          <h3 class="ab-card__title">Download résumé</h3>
          <p class="ab-card__body">Experience, skills and education on two pages.</p>
          <span class="ab-link">Résumé 2026 (PDF)</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .ab-quiet { display: block; font-style: italic; font-weight: 400; color: var(--ink-faint); }
  .ab-quiet--inline { display: inline; }

  .ab-hero-sec { padding: clamp(48px, 6vw, 88px) var(--gutter); }
  .ab-hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }
  .ab-hero img { width: 100%; height: auto; }
  .ab-hero__text { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; min-width: 0; }
  .ab-h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(40px, 4.6vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .ab-chips { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ab-chips li { padding: 8px 14px; border-radius: var(--radius-button); background: var(--surface-sand); font-size: 14px; font-weight: 500; }

  .ab-story-sec { padding: 0 var(--gutter) var(--section-y); }
  .ab-story {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: clamp(32px, 5vw, 72px);
    padding-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }
  .ab-story__head { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .ab-h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .ab-story__body { display: flex; flex-direction: column; gap: 16px; max-width: 640px; font-size: 16px; line-height: 1.6; color: var(--ink-soft); }
  .ab-story__body p { margin: 0; }

  .ab-caps-sec { background: var(--surface-sand); }
  .ab-caps__h2 { margin-top: 16px; }
  .ab-caps { margin-top: clamp(32px, 4vw, 48px); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .ab-cap { padding: 24px 22px; border-radius: var(--radius-card); background: var(--surface-card); display: flex; flex-direction: column; gap: 18px; }
  .ab-cap__icon { width: 36px; height: 36px; border-radius: var(--radius-chip); background: #FDF1E3; display: flex; align-items: center; justify-content: center; color: var(--brand); }
  .ab-cap__title { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: 19px; line-height: 1.2; }
  .ab-cap__list { list-style: none; margin: 0; padding: 0; }
  .ab-cap__list li { padding: 10px 0; border-top: 1px solid var(--line); font-size: 14px; line-height: 1.4; color: var(--ink-soft); }

  .ab-talk__head { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .ab-talk__h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .ab-talk__lede { margin: 0; max-width: 520px; font-size: 16px; line-height: 1.5; color: var(--ink-muted); }
  .ab-talk { margin-top: clamp(36px, 4vw, 56px); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .ab-card {
    padding: 24px 22px;
    border-radius: var(--radius-card);
    background: var(--surface-card);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    transition: border-color .2s ease;
  }
  .ab-card:hover { border-color: var(--line-strong); }
  .ab-card__icon { color: var(--brand); }
  .ab-card__title { margin: 6px 0 0; font-family: var(--font-display); font-weight: 500; font-size: 19px; }
  .ab-card__body { margin: 0; font-size: 14px; line-height: 1.45; color: var(--ink-muted); }
  .ab-link { align-self: flex-start; margin-top: 10px; font-size: 15px; border-bottom: 1px solid var(--line-dashed); transition: border-color .2s ease; }
  .ab-card:hover .ab-link { border-color: var(--ink); }

  @media (max-width: 1080px) { .ab-caps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    .ab-hero, .ab-story, .ab-talk { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) { .ab-caps { grid-template-columns: minmax(0, 1fr); } }
</style>
