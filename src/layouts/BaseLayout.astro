---
import '@fontsource-variable/dm-sans/opsz.css';
import '@fontsource-variable/dm-sans/opsz-italic.css';
import '@fontsource-variable/geist/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Case-study accent. Leave empty on Home and About. */
  accent?: string;
  /** Which header link is marked as the current page. */
  active?: 'none' | 'work' | 'about';
}

const { title, description = site.description, accent, active = 'none' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Product Designer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#EEEDE6" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      // Like Parley: above the 1440px design width, scale the whole page in
      // proportion instead of centring a fixed-width layout. Runs before paint.
      (function () {
        var d = document.documentElement, W = 1440;
        function fit() {
          var w = window.innerWidth, z = w > W ? w / W : 1;
          d.style.zoom = z > 1 ? z.toFixed(4) : '';
          // Inside a scaled page, vh/vw are scaled too; give layouts the real screen size.
          d.style.setProperty('--vh', z > 1 ? (window.innerHeight / z / 100).toFixed(3) + 'px' : '1vh');
          d.style.setProperty('--vw', z > 1 ? (w / z / 100).toFixed(3) + 'px' : '1vw');
        }
        fit();
        window.addEventListener('resize', fit);
      })();
    </script>
    <slot name="head" />
  </head>
  <body id="top" style={accent ? `--accent: ${accent}` : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header accent={accent} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer accent={accent} />
  </body>
</html>
